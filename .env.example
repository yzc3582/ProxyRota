# ===== QQ 机器人配置 =====
APP_ID=你的AppID
APP_SECRET=你的AppSecret
GROUP_OPENID=你的群openid
ROTABOT_OPENID=RotaBOT的openid

# ===== 图片保存路径配置 =====
# B40 图片固定保存路径（OBS 直接读取这个）
SAVE_PATH_B40=b40_latest.png

# 其它指令（如 /r me, /r chart）的图片保存路径
# 支持 {cmd} 占位符，程序会自动把 /r chart 替换为 _r_chart
# 如果指令返回多张图，程序会自动在末尾加上 _0, _1 等序号
SAVE_PATH_OTHER=img_{cmd}.png